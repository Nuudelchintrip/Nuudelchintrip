# Browser-safe Supabase configuration only.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_OTP_FUNCTION=send-otp

# Optional local-only fallback. It is ignored by production builds.
VITE_ALLOW_OTP_DEV_FALLBACK=false

# Server secrets such as SUPABASE_SERVICE_ROLE_KEY, MOCEAN_API_TOKEN,
# MOCEAN_SENDER, and RATE_LIMIT_HASH_SECRET belong in Supabase Edge Function
# secrets. Never prefix server secrets with VITE_ and never commit them.
